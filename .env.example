# Copy to .env (git-ignored) and set to the HanoiOK folder of your LeakDB download.
# The dataset must stay outside this repository.
LEAKSENSE_DATA_DIR=C:/path/to/hanoidataset/HanoiOK

# Optional: where caches/checkpoints are written (default: ./artifacts, git-ignored)
# LEAKSENSE_ARTIFACTS_DIR=./artifacts
